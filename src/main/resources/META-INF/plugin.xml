<idea-plugin>
    <id>com.yearrow.beaverui</id>
    <name>Beaver UI</name>
    <version>1.1.0</version>
    <vendor url="https://beaver-ui.yearrow.com">yearrow</vendor>

    <idea-version since-build="223.0"/>

    <description><![CDATA[
        Beaver UI 组件库的 JetBrains IDE 开发辅助插件：提供 b-* 标签自动补全、属性名与属性值提示、
        组件速查文档（Ctrl+Q，链接至组件官网）以及常用代码模板（Live Templates）。<br>
        内置数据对应 beaver-ui 1.0.1：全量 106 个 b-* 标签（含全部子组件与 table-kit / list-kit 套件）、1800+ 属性候选、插槽名补全（模板 #xxx 与 TSX {{ }} 双形态）、全局指令补全（v-loading / v-auto-tip / v-highlight-query / v-infinite-scroll），模板段与 TSX/JSX 双形态均可正常使用。<br>
        基于 <a href="https://github.com/jiaolong1021/ElementPlugin">ElementPlugin</a>（element-ui 插件，已停止维护）
        二次开发重构，感谢原作者。
]]></description>

    <change-notes><![CDATA[
      1.1.0：Live Templates context 修正——TSX/JSX 为平台从未注册的无效 ID（模板在 .tsx 中
      永不生效），改为实测校准的 TSX_HTML / JSX_HTML / TS_STATEMENT / VUE_* 系；标记模板同步
      补充 TSX_HTML/JSX_HTML（渲染函数场景）；bMessage 改为脚本语句模板。<br>
      数据全量对齐 beaver-ui 1.0.1（106 标签 / 1837 属性 / 194 插槽 / 34 指令）；
      属性名补全覆盖全部属性（不再局限于带枚举值属性）；新增插槽补全（模板 #伪属性 + TSX {{ }} 内
      slotName: () =&gt; 候选）；新增全局指令补全；Live Templates 扩充至 44 条（含 10 条 TSX 形态）；
      数据改由 beaver-ui 数据集驱动，可随组件库升级一键重新对齐（scripts/gen-plugin-data.mjs）。<br>
      1.0.0：品牌重塑为 Beaver UI；内置 beaver-ui 1.0.0 全量数据（b-* 标签、属性候选、
      速查文档、Live Templates）；构建链升级至 intellij-platform-gradle-plugin 2.x，
      兼容 IDEA 2023.1 及以上版本。
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <!-- VUE_TEMPLATE/VUE_SCRIPT/TSX/JSX 四个 live template context 由 Vue 插件注册 -->
    <depends>org.jetbrains.plugins.vue</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileTypeFactory implementation="com.yearrow.beaverui.ElementFileTypeFactory" />
        <!--<lang.parserDefinition language="element" implementationClass="com.elementent.language.elementParserDefinition"/>-->

        <!-- live templates -->
        <defaultLiveTemplatesProvider implementation="com.yearrow.beaverui.ElementTemplatesProvider"/>

        <!-- quick documentation (Ctrl+Q)：HTML/.vue 模板段 + TSX/JSX（TypeScript 语言域） -->
        <lang.documentationProvider language="HTML" implementationClass="com.yearrow.beaverui.document.DocumentProvider" order="first"/>
        <lang.documentationProvider language="TypeScript" implementationClass="com.yearrow.beaverui.document.DocumentProvider" order="first"/>

        <!-- tag completion / attribute hints -->
        <xml.tagNameProvider implementation="com.yearrow.beaverui.xml.ElementTagNameProvider"/>
        <xml.elementDescriptorProvider implementation="com.yearrow.beaverui.xml.ElementTagNameProvider" order="first"/>
        <xml.attributeDescriptorsProvider implementation="com.yearrow.beaverui.xml.ElementAttributesProvider" />

        <!-- TSX/JSX（Vue JSX）补全：标签名/属性名/属性值（文本启发式） -->
        <completion.contributor language="TypeScript" implementationClass="com.yearrow.beaverui.xml.BeaverJsxCompletionContributor"/>
        <completion.contributor language="JavaScript" implementationClass="com.yearrow.beaverui.xml.BeaverJsxCompletionContributor"/>
    </extensions>

    <actions>
        <!-- 属性候选快捷入口：光标在 b-* 标签属性（名/值/空引号）内 Ctrl+Alt+Q 弹候选并插入 -->
        <action id="com.yearrow.beaverui.AttrCandidates"
                class="com.yearrow.beaverui.xml.BeaverAttrAction"
                text="Beaver UI 属性候选"
                description="弹出当前属性的候选值并插入">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt Q"/>
        </action>
    </actions>
</idea-plugin>
