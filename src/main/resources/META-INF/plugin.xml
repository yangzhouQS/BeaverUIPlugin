<idea-plugin>
    <id>com.yearrow.beaverui</id>
    <name>Beaver UI</name>
    <version>1.0.0</version>
    <vendor url="https://beaver-ui.yearrow.com">yearrow</vendor>

    <idea-version since-build="223.0"/>

    <description><![CDATA[
        Beaver UI 组件库的 JetBrains IDE 开发辅助插件：提供 b-* 标签自动补全、属性名与属性值提示、
        组件速查文档（Ctrl+Q，链接至组件官网）以及常用代码模板（Live Templates）。<br>
        内置数据对应 beaver-ui 1.0.0（含 table-kit / list-kit / search 系列等自研组件与高频基础组件）。<br>
        基于 <a href="https://github.com/jiaolong1021/ElementPlugin">ElementPlugin</a>（element-ui 插件，已停止维护）
        二次开发重构，感谢原作者。
]]></description>

    <change-notes><![CDATA[
      1.0.0：品牌重塑为 Beaver UI；内置 beaver-ui 1.0.0 全量数据（b-* 标签、属性候选、
      速查文档、Live Templates）；构建链升级至 intellij-platform-gradle-plugin 2.x，
      兼容 IDEA 2023.1 及以上版本。
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileTypeFactory implementation="com.yearrow.beaverui.ElementFileTypeFactory" />
        <!--<lang.parserDefinition language="element" implementationClass="com.elementent.language.elementParserDefinition"/>-->

        <!-- live templates -->
        <defaultLiveTemplatesProvider implementation="com.yearrow.beaverui.ElementTemplatesProvider"/>

        <!-- quick documentation (Ctrl+Q) -->
        <lang.documentationProvider language="HTML" implementationClass="com.yearrow.beaverui.document.DocumentProvider" order="first"/>

        <!-- tag completion / attribute hints -->
        <xml.tagNameProvider implementation="com.yearrow.beaverui.xml.ElementTagNameProvider"/>
        <xml.elementDescriptorProvider implementation="com.yearrow.beaverui.xml.ElementTagNameProvider" order="first"/>
        <xml.attributeDescriptorsProvider implementation="com.yearrow.beaverui.xml.ElementAttributesProvider" />
    </extensions>

    <actions>
        <!-- 属性候选快捷入口：光标在 b-* 标签属性（名/值/空引号）内 Ctrl+Alt+Q 弹候选并插入 -->
        <action id="com.yearrow.beaverui.AttrCandidates"
                class="com.yearrow.beaverui.xml.BeaverAttrAction"
                text="Beaver UI 属性候选"
                description="弹出当前属性的候选值并插入">
            <keyboard-shortcut first-keystroke="ctrl alt Q"/>
        </action>
    </actions>
</idea-plugin>
